#include "mainwindow.h"
#include "tictactoe/tictactoewidget.h"
#include "hanoi/hanoiwidget.h"
#include <QTabWidget>
#include <QIcon>

MainWindow::MainWindow(QWidget *parent)
    : QMainWindow(parent)
{
    setWindowTitle("Juegos Qt — Álvaro Almanza");
    setMinimumSize(700, 580);

    m_tabs = new QTabWidget(this);
    m_tabs->setDocumentMode(true);
    m_tabs->addTab(new TicTacToeWidget(this), "  Triqui / Tic Tac Toe  ");
    m_tabs->addTab(new HanoiWidget(this),     "  Torre de Hanoi         ");
    setCentralWidget(m_tabs);
}

MainWindow::~MainWindow() {}
