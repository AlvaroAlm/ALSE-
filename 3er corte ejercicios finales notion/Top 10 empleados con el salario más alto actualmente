-- Base de datos: Employees | Nivel: Intermedio | Ejercicio: 03
-- Descripción : Top 10 empleados con el salario más alto actualmente
-- ============================================================

SELECT e.first_name,
       e.last_name,
       s.salary
FROM employees e
JOIN salaries s ON e.emp_no = s.emp_no
WHERE s.to_date = '9999-01-01'
ORDER BY s.salary DESC
LIMIT 10;
