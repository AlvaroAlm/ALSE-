-- Base de datos: Employees | Nivel: Intermedio | Ejercicio: 04
-- Descripción : Empleados que han trabajado en más de un departamento
-- ============================================================

SELECT e.emp_no,
       e.first_name,
       e.last_name,
       COUNT(DISTINCT de.dept_no) AS num_departamentos
FROM employees e
JOIN dept_emp de ON e.emp_no = de.emp_no
GROUP BY e.emp_no, e.first_name, e.last_name
HAVING COUNT(DISTINCT de.dept_no) > 1
ORDER BY num_departamentos DESC;
