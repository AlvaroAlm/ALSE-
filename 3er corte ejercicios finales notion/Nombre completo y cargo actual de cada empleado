-- Base de datos: Employees | Nivel: Intermedio | Ejercicio: 01
-- Descripción : Nombre completo y cargo actual de cada empleado
-- ============================================================

SELECT e.first_name,
       e.last_name,
       t.title
FROM employees e
JOIN titles t ON e.emp_no = t.emp_no
WHERE t.to_date = '9999-01-01'
ORDER BY e.last_name, e.first_name;
